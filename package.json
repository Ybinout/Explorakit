{
  "name": "explorakit",
  "version": "1.0.0",
  "description": "",
  "main": "server/index.js",
  "scripts": {
    "build:client": "npm --prefix vue-explorakit run build",
    "launch": "npm run build:client && npm start",
    "start": "node --env-file-if-exists=.env server/index.js",
    "grok": "node --env-file=.env scripts/grok.js",
    "grokpour": "npm run grok",
    "test": "node --test tests/*.test.js",
    "check:db": "node --env-file-if-exists=.env scripts/checkDatabase.js",
    "db:preflight": "node --env-file-if-exists=.env scripts/preflightMigration.js",
    "db:backup": "node --env-file-if-exists=.env scripts/backupDatabase.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/applyMigrations.js",
    "db:verify": "node --env-file-if-exists=.env scripts/verifyMigration.js",
    "db:test:setup": "node --env-file-if-exists=.env scripts/setupTestDatabase.js",
    "test:mysql": "node --env-file-if-exists=.env scripts/runMysqlTests.js",
    "test:http": "node --env-file-if-exists=.env scripts/smokeTestHttp.js",
    "test:visual": "node --env-file-if-exists=.env scripts/validateBattleViewports.js",
    "audit:moves": "node scripts/auditMoves.js",
    "audit:abilities": "node scripts/auditAbilities.js",
    "audit:content": "node scripts/auditGameContent.js",
    "generate:i18n": "node scripts/generateFrenchGameNames.js",
    "db:backfill:abilities": "node --env-file-if-exists=.env scripts/backfillPokemonAbilities.js",
    "audit:balance": "node scripts/auditExperienceBalance.js",
    "test:recovery": "node --env-file-if-exists=.env scripts/validateReleaseJourneys.js",
    "audit:simulation": "node scripts/simulateBalance.js",
    "verify:release": "node --env-file-if-exists=.env scripts/verifyRelease.js",
    "test:release-browser": "node --env-file-if-exists=.env scripts/validateReleaseBrowser.js",
    "test:colosseum-browser": "node --env-file-if-exists=.env scripts/validateColosseumBrowser.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@ngrok/ngrok": "^1.7.0",
    "bcrypt": "^5.1.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.6.1",
    "socket.io": "^4.7.2",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
