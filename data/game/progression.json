  "storySteps": [
    {
      "flag": "route_guard_defeated",
      "objective": "Parle à Timmy près de la sortie du village et bats-le pour obtenir une première piste sur ta sœur Lucie.",
      "map": "start",
      "destination": "Timmy · Village de départ"
    },
    {
      "flag": "aspha_route2_defeated",
      "objective": "Retrouve Aspha, le dresseur à la fin de la Route 2, juste avant la Ville du Lac, et gagne son duel.",
      "map": "route2",
      "destination": "Aspha · Fin de la Route 2"
    },
    {
      "flag": "moonpunch_defeated",
      "objective": "Aspha te dirige vers Mounir, surnommé Moonpunch. Affronte-le dans l’arène de la Ville du Lac.",
      "map": "ville1_arene",
      "destination": "Mounir · Arène de la Ville du Lac"
    },
    {
      "flag": "hoze_defeated",
      "objective": "Mounir te conseille Hoze à Valpierre. Traverse la Route 3 et les deux grottes, puis prends la Route 4 vers l’est et défie le champion.",
      "map": "ville_safe1_arene",
      "destination": "Hoze · Arène de Valpierre"
    },
    {
      "flag": "raphael_defeated",
      "objective": "Hoze t’envoie vers Raphael à Ocreville. Reviens sur la Route 4, prends la Route 8 au sud puis rejoins son arène, à l’ouest de la ville.",
      "map": "gen_arene5",
      "destination": "Raphael · Arène d’Ocreville"
    },
    {
      "flag": "ana_defeated",
      "objective": "Après Raphael, rejoins Ana dans l’arène de Clairfontaine : prends les Routes 9 et 10 au sud d’Ocreville.",
      "map": "ville3_arene",
      "destination": "Ana · Arène de Clairfontaine"
    },
    {
      "flag": "wanda_defeated",
      "objective": "Ana te dirige vers Wanda à Rochebrume. Quitte Clairfontaine par l’ouest, traverse les Routes 11 puis 12 et gagne le défi de son arène.",
      "map": "ville4_arene",
      "destination": "Wanda · Arène de Rochebrume"
    }
  ],
  "chapterConclusion": "Wanda t’a confié que Lucie a laissé une lettre à Éloi, aux archives de Clairbois. Garde cette nouvelle piste : la recherche de Lucie reprendra plus tard, lorsque le chemin sera ouvert.",
