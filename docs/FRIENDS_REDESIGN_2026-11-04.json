    "sessionDuration": "server connection timestamp, local clock adjusted by server time, refreshed every 15 seconds",
    "friendDetails": "read-only accepted friendship check; earned badges only; globally ranked 1v1/2v1/2v2 and tower records",
    "battleChat": "same persistent SQL conversation; narration space; no timer/pause/action changes; main battle buttons remain live",
    "mobileKeyboard": "visualViewport layout; no automatic focus; keyboard/pointer chat events never reach game movement/XP skipping",
    "desktop": "scene and controls reserve space with grid; toolbar clear of HP cards; enemy sprite positioned above player status",
    "messageDrafts": "per-peer, preserved in the open client, not a new server persistence feature"
