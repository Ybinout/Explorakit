  "fixes": {
    "rooms": "Toggle on repeated use; expire on the fifth end turn; Wonder Room exchanges base defenses while keeping the right stages; Magic Room item suppression/restoration retained; Magic Room clears an existing choice lock so the next move can lock normally when items resume",
    "hazards": "Correct opponent-side targeting bypasses Protect/substitute/semi-invulnerability/direct target ability checks; cap and fail at max; Magic Bounce retained; Toxic Spikes respects Misty Terrain and ignores Safeguard, grounded Poison absorbs; Web passes source and side to stat reactions",
    "removal": "Defog removes both hazards and target screens, preserves Tailwind/Lucky Chant; Mist can stop its evasion drop before clearing. Rapid Spin removes own hazards/bindings/Leech Seed on successful nonimmune hit; no gen8 Speed boost. Brick Break removes screens before damage, respects Protect and Ghost immunity",
    "screens": "Mist applies to move secondary drops and Intimidate, Infiltrator preserved. Criticals ignore Reflect/Light Screen. Wide Guard only spread offense, Mat Block does not stop status and is entry-only. All four guards expire and are displayed; Quick Guard includes priority granted by talents such as Prankster",
    "terrain": "Electric/Grassy/Psychic boost grounded attackers by gen7 x1.5; Grassy reduces Earthquake/Bulldoze/Magnitude; Misty prevents grounded confusion; Psychic priority uses actual grounding. Gravity accuracy x5/3, grounding removed when expired. Mud/Water Sport exact one-third",
    "other": "Ion Deluge accuracy corrected to always hit, same-turn Normal to Electric; Fairy Lock lasts through next turn with Ghost escape and no refresh. A dead entrant never runs further entry effects",
    "generation": "Generator explicitly omits modern Rapid Spin secondary in gen7; no runtime dependency update"
  },
  "presentation": {
    "state": "Bounded allowlist of field timers, hazard layers and team protections, per-viewer sides; unknown/missing fields safe for legacy clients, WeakMap player orientation in classic PvP, explicit viewer side in Drift and reconnect; no private teams/actions",
    "visuals": "SVG ground rocks/spikes/toxic spikes/web, panels, wind, room grid, gravity/sports/lock; entry and clearing particles; compact optional inspector with effect, side and duration",
    "timing": "Wire order preserved in shared queue, field deferred until move impact alongside HP, pending state discarded on cancellation; duration-only sync does not replay changes",
    "compatibility": "Four sizes/two themes/reduced motion; no assets or JS animation loop, bounded DOM; old terrain text removed from action notices"
  },
